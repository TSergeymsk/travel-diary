<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title>
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; }
  :root {
    --bg: #0e0e10; --fg: #eeeae4; --muted: #8a8a8a; --accent: #d97757;
    --card: rgba(255,255,255,.02); --line: rgba(255,255,255,.08);
  }
  body[data-theme="light"] {
    --bg: #f6f3ee; --fg: #1a1a1a; --muted: #6a6a6a; --accent: #a84a2b;
    --card: rgba(0,0,0,.03); --line: rgba(0,0,0,.08);
  }
  body {
    font-family: 'Iowan Old Style','Palatino','Georgia',serif;
    background: var(--bg); color: var(--fg); overflow: hidden;
  }
  #deck { position: relative; height: 100vh; }
  .slide {
    position: absolute; inset: 0; display: none;
    padding: 6vh 6vw 10vh;
    animation: fade .5s ease;
  }
  .slide.active { display: grid; }
  @keyframes fade {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
  }

  /* ---- обложка ---- */
  .slide--cover { grid-template-columns: 1fr; place-items: center; text-align: center; }
  .slide--cover .cover-bg {
    position: absolute; inset: 0; z-index: 0;
    background-size: cover; background-position: center;
    filter: brightness(.35) saturate(.9);
  }
  .slide--cover > * { position: relative; z-index: 1; }
  .slide--cover h1 {
    font-size: clamp(2.2rem, 5.5vw, 4.2rem); font-weight: 500;
    margin: 0 0 .3em; letter-spacing: -.01em;
  }
  .slide--cover .sub { font-size: 1.25rem; color: var(--muted); }
  .slide--cover .meta {
    margin-top: 2.2em; font-size: .85rem; letter-spacing: .28em;
    text-transform: uppercase; color: var(--muted);
  }

  /* ---- пролог / финал ---- */
  .slide--intro, .slide--finale { place-items: center; text-align: center; }
  .slide--intro .inner, .slide--finale .inner { max-width: 42em; }
  .slide--intro h2, .slide--finale h2 {
    font-size: .9rem; letter-spacing: .35em; text-transform: uppercase;
    color: var(--accent); margin: 0 0 1.2em;
  }
  .slide--intro p, .slide--finale p {
    font-size: clamp(1.05rem, 1.6vw, 1.4rem);
    line-height: 1.75; white-space: pre-wrap; margin: 0;
  }

  /* ---- обзор маршрута ---- */
  .slide--overview { place-items: center; }
  .slide--overview .inner {
    display: grid; grid-template-columns: 1fr 1fr; gap: 4vw;
    max-width: 90em; width: 100%; align-items: start;
  }
  .slide--overview h2 {
    grid-column: 1 / -1;
    font-size: .9rem; letter-spacing: .35em; text-transform: uppercase;
    color: var(--accent); margin: 0 0 .4em;
  }
  .route-narrative {
    font-size: 1.1rem; line-height: 1.72; white-space: pre-wrap;
    color: color-mix(in srgb, var(--fg) 88%, var(--bg));
  }
  .route-stops {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: .7em;
    border-left: 2px solid var(--accent); padding-left: 1.2em;
  }
  .route-stops li {
    display: grid;
    grid-template-columns: 4.5em 3em 1fr auto;
    gap: .8em; align-items: baseline;
    font-size: .98rem;
  }
  .route-stops .stop-day { color: var(--accent); letter-spacing: .08em; font-size: .78rem; text-transform: uppercase; }
  .route-stops .stop-date { color: var(--muted); font-size: .82rem; }
  .route-stops .stop-place { color: var(--fg); }
  .route-stops .stop-km { color: var(--muted); font-size: .82rem; }

  /* ---- day-intro ---- */
  .slide--day-intro {
    grid-template-rows: auto auto 1fr;
    gap: 3vh; align-content: start;
  }
  .day-header { text-align: center; }
  .day-header .day-meta {
    font-size: .78rem; letter-spacing: .28em; text-transform: uppercase;
    color: var(--accent); margin-bottom: .4em;
  }
  .day-header h2 {
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    margin: 0; font-weight: 500; line-height: 1.15;
  }
  .day-header .day-km { color: var(--muted); font-size: .95rem; margin-top: .4em; }
  .day-intro-text {
    max-width: 42em; margin: 0 auto;
    font-size: 1.15rem; line-height: 1.72;
    text-align: center; white-space: pre-wrap;
  }
  .day-photo-strip {
    display: grid; grid-auto-flow: column; grid-auto-columns: 1fr;
    gap: .8vw; max-height: 40vh; min-height: 0;
  }
  .day-photo-strip img {
    width: 100%; height: 100%; object-fit: cover;
    border-radius: 6px; display: block; min-height: 0;
    cursor: zoom-in;
  }

  /* ---- location / day ---- */
  .slide--location, .slide--day {
    grid-template-columns: 1.15fr 1fr;
    gap: 4vw; align-items: center;
  }
  .slide--location.reverse, .slide--day.reverse {
    grid-template-columns: 1fr 1.15fr;
  }
  .slide--location.reverse .photo-col,
  .slide--day.reverse .photo-col { order: 2; }

  .photo-col {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: .8vw; max-height: 78vh; min-height: 0;
  }
  .photo-col img {
    width: 100%; height: 100%; object-fit: cover;
    border-radius: 6px; min-height: 0; display: block;
    cursor: zoom-in;
  }
  .photo-col.count-1 { grid-template-columns: 1fr; }
  .photo-col.count-1 img { max-height: 76vh; }
  .photo-col.count-3 img:first-child { grid-row: span 2; }
  .photo-col.count-5 img:first-child { grid-row: span 2; }

  .text-col {
    display: flex; flex-direction: column; gap: 1em;
    max-height: 80vh; overflow-y: auto; padding-right: .6em;
  }
  .text-col::-webkit-scrollbar { width: 4px; }
  .text-col::-webkit-scrollbar-thumb { background: var(--muted); border-radius: 2px; }
  .text-col .day-meta {
    font-size: .78rem; letter-spacing: .28em; text-transform: uppercase;
    color: var(--accent);
  }
  .text-col h2 {
    font-size: clamp(1.5rem, 2.6vw, 2.3rem);
    margin: 0; font-weight: 500; line-height: 1.15;
  }
  .text-col .place-name { color: var(--muted); font-size: .95rem; }
  .text-col .day-km { color: var(--muted); font-size: .95rem; }
  .text-col .narrative {
    font-size: 1.05rem; line-height: 1.72;
    white-space: pre-wrap; color: var(--fg);
  }
  .text-col .wiki {
    font-size: .92rem; line-height: 1.6; margin-top: .4em;
    color: color-mix(in srgb, var(--fg) 65%, var(--bg));
    font-style: italic;
    border-left: 2px solid var(--line); padding-left: .8em;
  }
  .text-col .vision {
    font-size: .88rem; line-height: 1.55; margin-top: .4em;
    color: color-mix(in srgb, var(--fg) 55%, var(--bg));
  }

  .clusters {
    display: flex; flex-direction: column; gap: .9em;
    margin-top: .4em; padding-top: 1em; border-top: 1px solid var(--line);
  }
  .cluster { border-left: 2px solid var(--accent); padding-left: 1em; }
  .cluster h3 {
    font-size: 1.02rem; margin: 0 0 .2em; font-weight: 600;
  }
  .cluster .place {
    font-size: .8rem; color: var(--muted); margin-bottom: .35em;
  }
  .cluster p {
    font-size: .95rem; line-height: 1.6; margin: 0;
    color: color-mix(in srgb, var(--fg) 82%, var(--bg));
  }
  .cluster .wiki {
    font-size: .9rem; line-height: 1.6; margin-top: .5em;
    color: color-mix(in srgb, var(--fg) 65%, var(--bg));
    font-style: italic;
  }

  /* ---- transit ---- */
  .slide--transit {
    grid-template-rows: auto auto 1fr auto;
    gap: 3vh; align-content: start;
  }
  .slide--transit .head { text-align: center; }
  .slide--transit .head h2 {
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    margin: .2em 0 0; font-weight: 500;
  }
  .transit-photos {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: .8vw; max-height: 42vh;
  }
  .transit-photos img {
    width: 100%; height: 100%; object-fit: cover;
    border-radius: 6px; display: block; cursor: zoom-in;
  }
  .transit-list {
    display: grid; grid-template-columns: 1fr 1fr; gap: .6em 2em;
    font-size: .92rem;
  }
  .transit-list .item { display: flex; gap: .6em; align-items: baseline; }
  .transit-list .item .bullet { color: var(--accent); }
  .transit-list .item .desc {
    color: color-mix(in srgb, var(--fg) 65%, var(--bg));
    font-size: .85rem;
  }

  /* ---- lightbox ---- */
  .lightbox {
    position: fixed; inset: 0; z-index: 100;
    display: none;
    background: rgba(0, 0, 0, .93);
    backdrop-filter: blur(4px);
    align-items: center; justify-content: center;
    animation: lb-fade .15s ease;
    padding: 2vh 0;
    overflow-y: auto;
  }
  .lightbox.open { display: flex; }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }

  .lb-stage {
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: .9em;
    max-width: 94vw;
  }
  .lb-img {
    max-width: 94vw; max-height: 74vh;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 20px 60px rgba(0,0,0,.5);
    user-select: none;
  }
  .lb-info {
    max-width: min(60em, 94vw);
    text-align: center;
    color: #ccc;
    font-size: .95rem; line-height: 1.55;
    padding: 0 1em;
  }
  .lb-place {
    color: var(--accent);
    letter-spacing: .2em; text-transform: uppercase;
    font-size: .72rem; margin-bottom: .35em;
  }
  .lb-title {
    font-size: 1.15rem; color: #fff;
    margin-bottom: .45em;
  }
  .lb-description {
    font-style: italic; color: rgba(255,255,255,.78);
  }
  .lb-place:empty, .lb-title:empty, .lb-description:empty { display: none; }

  .lb-btn {
    position: absolute;
    background: rgba(0,0,0,.4);
    border: 1px solid rgba(255,255,255,.2);
    color: #eee;
    font: inherit;
    cursor: pointer;
    border-radius: 999px;
    display: flex; align-items: center; justify-content: center;
    transition: background .15s, border-color .15s;
    user-select: none;
  }
  .lb-btn:hover { background: rgba(0,0,0,.7); border-color: var(--accent); }
  .lb-close {
    top: 2.5vh; right: 2.5vw;
    width: 2.8em; height: 2.8em;
    font-size: 1.4rem; line-height: 1;
  }
  .lb-prev, .lb-next {
    top: 50%; transform: translateY(-50%);
    width: 3.2em; height: 3.2em;
    font-size: 1.6rem; line-height: 1;
  }
  .lb-prev { left: 2.5vw; }
  .lb-next { right: 2.5vw; }
  .lb-prev::before { content: "‹"; }
  .lb-next::before { content: "›"; }
  .lb-counter {
    position: absolute; bottom: 2.5vh; left: 50%; transform: translateX(-50%);
    color: #ccc; font-size: .9rem; letter-spacing: .15em;
    padding: .3em 1em; border-radius: 999px;
    background: rgba(0,0,0,.4);
  }

  /* ---- навигация слайдов ---- */
  #nav {
    position: fixed; bottom: 2.5vh; left: 0; right: 0;
    display: flex; justify-content: space-between; align-items: center;
    padding: 0 6vw; pointer-events: none; z-index: 10;
    font-size: .85rem; color: var(--muted);
  }
  #nav button {
    pointer-events: auto; background: transparent;
    border: 1px solid var(--muted); color: inherit;
    font: inherit; padding: .4em 1.1em; border-radius: 999px;
    cursor: pointer; transition: .2s;
  }
  #nav button:hover { border-color: var(--accent); color: var(--accent); }
  #counter { min-width: 5em; text-align: center; letter-spacing: .1em; }

  #nav .nav-center {
    display: flex; align-items: center; gap: 1.2em;
    pointer-events: auto;
  }
  #copy-link {
    font-size: .78rem;
    padding: .35em .9em;
  }

  #progress {
    position: fixed; top: 0; left: 0; height: 3px;
    background: var(--accent); transition: width .3s; z-index: 11;
  }

  /* ---- toast ---- */
  #toast {
    position: fixed; bottom: 8vh; left: 50%; transform: translateX(-50%);
    background: rgba(0,0,0,.85); color: #eee;
    padding: .5em 1.2em; border-radius: 999px;
    font-size: .85rem; letter-spacing: .05em;
    opacity: 0; pointer-events: none;
    transition: opacity .25s; z-index: 200;
  }
  #toast.show { opacity: 1; }
</style>
</head>
<body data-theme="{{ theme }}">
<div id="progress" style="width:0"></div>
<div id="deck">
  {% for s in slides %}
    {% set slide_id = 'slide-' ~ loop.index %}

    {% if s.kind == 'cover' %}
      <section class="slide slide--cover" id="{{ slide_id }}">
        {% if s.photo %}<div class="cover-bg" style="background-image:url('{{ s.photo }}')"></div>{% endif %}
        <h1>{{ s.title }}</h1>
        <div class="sub">{{ s.subtitle }}</div>
        <div class="meta">{{ s.meta }}</div>
      </section>

    {% elif s.kind in ('intro', 'finale') %}
      <section class="slide slide--{{ s.kind }}" id="{{ slide_id }}">
        <div class="inner">
          <h2>{{ s.title }}</h2>
          <p>{{ s.text }}</p>
        </div>
      </section>

    {% elif s.kind == 'overview' %}
      <section class="slide slide--overview" id="{{ slide_id }}">
        <div class="inner">
          <h2>{{ s.title }}</h2>
          <div class="route-narrative">{{ s.narrative }}</div>
          <ol class="route-stops">
            {% for stop in s.stops %}
              <li>
                <span class="stop-day">День {{ stop.day }}</span>
                <span class="stop-date">{{ stop.date }}</span>
                <span class="stop-place">{{ stop.place }}</span>
                <span class="stop-km">{{ stop.km }}</span>
              </li>
            {% endfor %}
          </ol>
        </div>
      </section>

    {% elif s.kind == 'day-intro' %}
      <section class="slide slide--day-intro" id="{{ slide_id }}">
        <div class="day-header">
          <div class="day-meta">День {{ s.index }} · {{ s.date }}</div>
          <h2>{{ s.title }}</h2>
          {% if s.meta %}<div class="day-km">{{ s.meta }}</div>{% endif %}
        </div>
        <p class="day-intro-text">{{ s.narrative }}</p>
        <div class="day-photo-strip">
          {% for p in s.photos %}
            <img src="{{ p.url }}"
                 data-description="{{ p.description }}"
                 data-place="{{ p.place }}"
                 data-title="{{ p.title }}"
                 alt="" loading="lazy">
          {% endfor %}
        </div>
      </section>

    {% elif s.kind == 'location' %}
      <section class="slide slide--location{% if s.index % 2 == 0 %} reverse{% endif %}" id="{{ slide_id }}">
        <div class="photo-col count-{{ s.photos|length }}">
          {% for p in s.photos %}
            <img src="{{ p.url }}"
                 data-description="{{ p.description }}"
                 data-place="{{ p.place }}"
                 data-title="{{ p.title }}"
                 alt="" loading="lazy">
          {% endfor %}
        </div>
        <div class="text-col">
          <div class="day-meta">День {{ s.index }} · {{ s.date }}</div>
          <h2>{{ s.title }}</h2>
          {% if s.place %}<div class="place-name">{{ s.place }}</div>{% endif %}
          {% if s.meta %}<div class="day-km">{{ s.meta }}</div>{% endif %}
          {% if s.narrative %}<div class="narrative">{{ s.narrative }}</div>{% endif %}
          {% if s.wiki %}<p class="wiki">{{ s.wiki }}</p>{% endif %}
          {% if s.description %}<p class="vision">{{ s.description }}</p>{% endif %}
        </div>
      </section>

    {% elif s.kind == 'transit' %}
      <section class="slide slide--transit" id="{{ slide_id }}">
        <div class="head">
          <div class="day-meta">День {{ s.index }} · {{ s.date }}</div>
          <h2>Между локациями</h2>
        </div>
        <div class="transit-photos">
          {% for p in s.photos %}
            <img src="{{ p.url }}"
                 data-description="{{ p.description }}"
                 data-place="{{ p.place }}"
                 data-title="{{ p.title }}"
                 alt="" loading="lazy">
          {% endfor %}
        </div>
        <div class="transit-list">
          {% for c in s.clusters %}
            <div class="item">
              <span class="bullet">·</span>
              <span class="place">{{ c.place or '—' }}</span>
              {% if c.description %}<span class="desc">{{ c.description }}</span>{% endif %}
            </div>
          {% endfor %}
        </div>
      </section>

    {% elif s.kind == 'day' %}
      <section class="slide slide--day{% if s.index % 2 == 0 %} reverse{% endif %}" id="{{ slide_id }}">
        <div class="photo-col count-{{ s.photos|length }}">
          {% for p in s.photos %}
            <img src="{{ p.url }}"
                 data-description="{{ p.description }}"
                 data-place="{{ p.place }}"
                 data-title="{{ p.title }}"
                 alt="" loading="lazy">
          {% endfor %}
        </div>
        <div class="text-col">
          <div class="day-meta">День {{ s.index }} · {{ s.date }}</div>
          <h2>{{ s.title }}</h2>
          {% if s.meta %}<div class="day-km">{{ s.meta }}</div>{% endif %}
          {% if s.narrative %}<div class="narrative">{{ s.narrative }}</div>{% endif %}
          {% if s.clusters %}
            <div class="clusters">
              {% for c in s.clusters %}
                <div class="cluster">
                  <h3>{{ c.title }}</h3>
                  {% if c.place %}<div class="place">{{ c.place }}</div>{% endif %}
                  {% if c.narrative %}<p>{{ c.narrative }}</p>{% endif %}
                  {% if c.description %}<p>{{ c.description }}</p>{% endif %}
                  {% if c.wiki %}<p class="wiki">{{ c.wiki }}</p>{% endif %}
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </section>
    {% endif %}
  {% endfor %}
</div>

<!-- lightbox -->
<div id="lightbox" class="lightbox" aria-hidden="true">
  <button class="lb-btn lb-close" aria-label="Закрыть">×</button>
  <button class="lb-btn lb-prev" aria-label="Предыдущее фото"></button>
  <div class="lb-stage">
    <img class="lb-img" alt="">
    <div class="lb-info">
      <div class="lb-place"></div>
      <div class="lb-title"></div>
      <div class="lb-description"></div>
    </div>
  </div>
  <button class="lb-btn lb-next" aria-label="Следующее фото"></button>
  <div class="lb-counter"></div>
</div>

<div id="nav">
  <button id="prev">← Назад</button>
  <div class="nav-center">
    <span id="counter"></span>
    <button id="copy-link" title="Скопировать ссылку на этот слайд">🔗 Ссылка</button>
  </div>
  <button id="next">Вперёд →</button>
</div>

<div id="toast"></div>

<script>
  // ---------- слайды ----------
  const slides = [...document.querySelectorAll('.slide')];
  const counter = document.getElementById('counter');
  const bar = document.getElementById('progress');
  let i = 0;

  function updateHash() {
    const newHash = `#slide-${i + 1}`;
    if (location.hash !== newHash) {
      history.replaceState(null, '', newHash);
    }
  }

  function show(n) {
    i = Math.max(0, Math.min(slides.length - 1, n));
    slides.forEach((s, k) => s.classList.toggle('active', k === i));
    counter.textContent = `${i + 1} / ${slides.length}`;
    bar.style.width = ((i + 1) / slides.length * 100) + '%';
    updateHash();
  }
  document.getElementById('prev').onclick = () => show(i - 1);
  document.getElementById('next').onclick = () => show(i + 1);

  // ---------- копирование ссылки на слайд ----------
  const toastEl = document.getElementById('toast');
  let toastTimer = null;
  function showToast(msg) {
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toastEl.classList.remove('show'), 1800);
  }

  document.getElementById('copy-link').onclick = async () => {
    const baseUrl = location.href.split('#')[0];
    const url = `${baseUrl}#slide-${i + 1}`;
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(url);
      } else {
        // fallback для file:// и http без secure context
        const tmp = document.createElement('textarea');
        tmp.value = url;
        tmp.style.position = 'fixed';
        tmp.style.opacity = '0';
        document.body.appendChild(tmp);
        tmp.select();
        document.execCommand('copy');
        document.body.removeChild(tmp);
      }
      showToast('Ссылка скопирована');
    } catch (err) {
      showToast('Не удалось скопировать');
    }
  };

  // ---------- lightbox ----------
  const lb = document.getElementById('lightbox');
  const lbImg = lb.querySelector('.lb-img');
  const lbCounter = lb.querySelector('.lb-counter');
  const lbPlace = lb.querySelector('.lb-place');
  const lbTitle = lb.querySelector('.lb-title');
  const lbDesc = lb.querySelector('.lb-description');
  const lbPrev = lb.querySelector('.lb-prev');
  const lbNext = lb.querySelector('.lb-next');
  let lbPhotos = [];
  let lbIndex = 0;

  function lbRender() {
    if (!lbPhotos.length) return;
    const el = lbPhotos[lbIndex];
    lbImg.src = el.src;
    lbImg.alt = el.alt || '';
    lbCounter.textContent = `${lbIndex + 1} / ${lbPhotos.length}`;
    lbPlace.textContent = el.dataset.place || '';
    lbTitle.textContent = el.dataset.title || '';
    lbDesc.textContent = el.dataset.description || '';
    const multi = lbPhotos.length > 1;
    lbPrev.style.display = multi ? '' : 'none';
    lbNext.style.display = multi ? '' : 'none';
  }

  function lbOpen(photoList, idx) {
    lbPhotos = photoList;
    lbIndex = idx;
    lbRender();
    lb.classList.add('open');
    lb.setAttribute('aria-hidden', 'false');
  }

  function lbClose() {
    lb.classList.remove('open');
    lb.setAttribute('aria-hidden', 'true');
  }

  function lbNav(delta) {
    if (lbPhotos.length < 2) return;
    lbIndex = (lbIndex + delta + lbPhotos.length) % lbPhotos.length;
    lbRender();
  }

  document.querySelectorAll('.slide img').forEach(img => {
    img.addEventListener('click', e => {
      e.preventDefault();
      e.stopPropagation();
      const slide = img.closest('.slide');
      const slideImgs = [...slide.querySelectorAll('img')];
      const idx = slideImgs.indexOf(img);
      lbOpen(slideImgs, idx >= 0 ? idx : 0);
    });
  });

  lb.querySelector('.lb-close').onclick = e => { e.stopPropagation(); lbClose(); };
  lbPrev.onclick = e => { e.stopPropagation(); lbNav(-1); };
  lbNext.onclick = e => { e.stopPropagation(); lbNav(1); };
  lb.addEventListener('click', e => { if (e.target === lb) lbClose(); });

  // ---------- клавиатура ----------
  document.addEventListener('keydown', e => {
    if (lb.classList.contains('open')) {
      if (e.key === 'Escape') { e.preventDefault(); lbClose(); return; }
      if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') {
        e.preventDefault(); lbNav(1); return;
      }
      if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        e.preventDefault(); lbNav(-1); return;
      }
      return;
    }
    if (['ArrowRight', ' ', 'PageDown'].includes(e.key)) {
      e.preventDefault(); show(i + 1);
    }
    if (['ArrowLeft', 'PageUp'].includes(e.key)) {
      e.preventDefault(); show(i - 1);
    }
    if (e.key === 'Home') show(0);
    if (e.key === 'End') show(slides.length - 1);
  });

  // ---------- hash-навигация ----------
  function slideFromHash() {
    const m = location.hash.match(/^#slide-(\d+)$/);
    if (!m) return null;
    const n = parseInt(m[1], 10) - 1;
    return (n >= 0 && n < slides.length) ? n : null;
  }

  window.addEventListener('hashchange', () => {
    const n = slideFromHash();
    if (n !== null && n !== i) show(n);
  });

  // старт: если в URL есть #slide-N — открываем его, иначе первый
  const initial = slideFromHash();
  show(initial !== null ? initial : 0);
</script>
</body>
</html>