<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title>
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; }
  :root {
    --bg: #0e0e10; --fg: #eeeae4; --muted: #8a8a8a; --accent: #d97757;
    --card: rgba(255,255,255,.02); --line: rgba(255,255,255,.08);
  }
  body[data-theme="light"] {
    --bg: #f6f3ee; --fg: #1a1a1a; --muted: #6a6a6a; --accent: #a84a2b;
    --card: rgba(0,0,0,.03); --line: rgba(0,0,0,.08);
  }
  body {
    font-family: 'Iowan Old Style','Palatino','Georgia',serif;
    background: var(--bg); color: var(--fg); overflow: hidden;
  }
  #deck { position: relative; height: 100vh; }
  .slide {
    position: absolute; inset: 0; display: none;
    padding: 6vh 6vw 10vh;
    animation: fade .5s ease;
  }
  .slide.active { display: grid; }
  @keyframes fade {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
  }

  /* обложка */
  .slide--cover { grid-template-columns: 1fr; place-items: center; text-align: center; }
  .slide--cover .cover-bg {
    position: absolute; inset: 0; z-index: 0;
    background-size: cover; background-position: center;
    filter: brightness(.35) saturate(.9);
  }
  .slide--cover > * { position: relative; z-index: 1; }
  .slide--cover h1 {
    font-size: clamp(2.2rem, 5.5vw, 4.2rem); font-weight: 500;
    margin: 0 0 .3em; letter-spacing: -.01em;
  }
  .slide--cover .sub { font-size: 1.25rem; color: var(--muted); }
  .slide--cover .meta {
    margin-top: 2.2em; font-size: .85rem; letter-spacing: .28em;
    text-transform: uppercase; color: var(--muted);
  }

  /* пролог / финал */
  .slide--intro, .slide--finale { place-items: center; text-align: center; }
  .slide--intro .inner, .slide--finale .inner { max-width: 42em; }
  .slide--intro h2, .slide--finale h2 {
    font-size: .9rem; letter-spacing: .35em; text-transform: uppercase;
    color: var(--accent); margin: 0 0 1.2em;
  }
  .slide--intro p, .slide--finale p {
    font-size: clamp(1.05rem, 1.6vw, 1.4rem);
    line-height: 1.75; white-space: pre-wrap; margin: 0;
  }

  /* день */
  .slide--day {
    grid-template-columns: 1.15fr 1fr;
    gap: 4vw; align-items: center;
  }
  .slide--day.reverse { grid-template-columns: 1fr 1.15fr; }
  .slide--day.reverse .photo-col { order: 2; }

  .photo-col {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: .8vw; max-height: 78vh; min-height: 0;
  }
  .photo-col img {
    width: 100%; height: 100%; object-fit: cover;
    border-radius: 6px; min-height: 0; display: block;
  }
  .photo-col.count-1 { grid-template-columns: 1fr; }
  .photo-col.count-1 img { max-height: 76vh; }
  .photo-col.count-3 img:first-child { grid-row: span 2; }
  .photo-col.count-5 img:first-child { grid-row: span 2; }

  .text-col {
    display: flex; flex-direction: column; gap: 1em;
    max-height: 80vh; overflow-y: auto; padding-right: .6em;
  }
  .text-col::-webkit-scrollbar { width: 4px; }
  .text-col::-webkit-scrollbar-thumb { background: var(--muted); border-radius: 2px; }
  .text-col .day-meta {
    font-size: .78rem; letter-spacing: .28em; text-transform: uppercase;
    color: var(--accent);
  }
  .text-col h2 {
    font-size: clamp(1.5rem, 2.6vw, 2.3rem);
    margin: 0; font-weight: 500; line-height: 1.15;
  }
  .text-col .day-km { color: var(--muted); font-size: .95rem; }
  .text-col .narrative {
    font-size: 1.05rem; line-height: 1.72;
    white-space: pre-wrap; color: var(--fg);
  }
  .clusters {
    display: flex; flex-direction: column; gap: .9em;
    margin-top: .4em; padding-top: 1em; border-top: 1px solid var(--line);
  }
  .cluster { border-left: 2px solid var(--accent); padding-left: 1em; }
  .cluster h3 {
    font-size: 1.02rem; margin: 0 0 .2em; font-weight: 600;
    letter-spacing: .01em;
  }
  .cluster .place {
    font-size: .8rem; color: var(--muted);
    margin-bottom: .35em; letter-spacing: .05em;
  }
  .cluster p {
    font-size: .95rem; line-height: 1.6; margin: 0;
    color: color-mix(in srgb, var(--fg) 82%, var(--bg));
  }
  .cluster .wiki {
    font-size: .9rem; line-height: 1.6; margin-top: .5em;
    color: color-mix(in srgb, var(--fg) 65%, var(--bg));
    font-style: italic;
  }

  /* навигация */
  #nav {
    position: fixed; bottom: 2.5vh; left: 0; right: 0;
    display: flex; justify-content: space-between; align-items: center;
    padding: 0 6vw; pointer-events: none; z-index: 10;
    font-size: .85rem; color: var(--muted);
  }
  #nav button {
    pointer-events: auto; background: transparent;
    border: 1px solid var(--muted); color: inherit;
    font: inherit; padding: .4em 1.1em; border-radius: 999px;
    cursor: pointer; transition: .2s;
  }
  #nav button:hover { border-color: var(--accent); color: var(--accent); }
  #counter { min-width: 5em; text-align: center; letter-spacing: .1em; }
  #progress {
    position: fixed; top: 0; left: 0; height: 3px;
    background: var(--accent); transition: width .3s; z-index: 11;
  }
</style>
</head>
<body data-theme="{{ theme }}">
<div id="progress" style="width:0"></div>
<div id="deck">
  {% for s in slides %}
    {% if s.kind == 'cover' %}
      <section class="slide slide--cover">
        {% if s.photo %}<div class="cover-bg" style="background-image:url('{{ s.photo }}')"></div>{% endif %}
        <h1>{{ s.title }}</h1>
        <div class="sub">{{ s.subtitle }}</div>
        <div class="meta">{{ s.meta }}</div>
      </section>
    {% elif s.kind in ('intro', 'finale') %}
      <section class="slide slide--{{ s.kind }}">
        <div class="inner">
          <h2>{{ s.title }}</h2>
          <p>{{ s.text }}</p>
        </div>
      </section>
    {% elif s.kind == 'day' %}
      <section class="slide slide--day{% if s.index % 2 == 0 %} reverse{% endif %}">
        <div class="photo-col count-{{ s.photos|length }}">
          {% for p in s.photos %}<img src="{{ p }}" alt="" loading="lazy">{% endfor %}
        </div>
        <div class="text-col">
          <div class="day-meta">День {{ s.index }} · {{ s.date }}</div>
          <h2>{{ s.title }}</h2>
          {% if s.meta %}<div class="day-km">{{ s.meta }}</div>{% endif %}
          {% if s.narrative %}<div class="narrative">{{ s.narrative }}</div>{% endif %}
          {% if s.clusters %}
            <div class="clusters">
              {% for c in s.clusters %}
                <div class="cluster">
                  <h3>{{ c.title }}</h3>
                  {% if c.place %}<div class="place">{{ c.place }}</div>{% endif %}
                  {% if c.description %}<p>{{ c.description }}</p>{% endif %}
                  {% if c.wiki %}<p class="wiki">{{ c.wiki }}</p>{% endif %}
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </section>
    {% endif %}
  {% endfor %}
</div>

<div id="nav">
  <button id="prev">← Назад</button>
  <span id="counter"></span>
  <button id="next">Вперёд →</button>
</div>

<script>
  const slides = [...document.querySelectorAll('.slide')];
  const counter = document.getElementById('counter');
  const bar = document.getElementById('progress');
  let i = 0;

  function show(n) {
    i = Math.max(0, Math.min(slides.length - 1, n));
    slides.forEach((s, k) => s.classList.toggle('active', k === i));
    counter.textContent = `${i + 1} / ${slides.length}`;
    bar.style.width = ((i + 1) / slides.length * 100) + '%';
  }
  document.getElementById('prev').onclick = () => show(i - 1);
  document.getElementById('next').onclick = () => show(i + 1);
  document.addEventListener('keydown', e => {
    if (['ArrowRight', ' ', 'PageDown'].includes(e.key)) { e.preventDefault(); show(i + 1); }
    if (['ArrowLeft', 'PageUp'].includes(e.key)) { e.preventDefault(); show(i - 1); }
    if (e.key === 'Home') show(0);
    if (e.key === 'End') show(slides.length - 1);
  });
  show(0);
</script>
</body>
</html>